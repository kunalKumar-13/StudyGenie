# ── StudyGenie Environment Variables ──

# (Optional) Gemini API Key — get one free at https://aistudio.google.com/apikey
# Leave blank to use Ollama only (fully local, no API needed)
GEMINI_API_KEY=

# LLM Provider: "gemini" (cloud, fast) or "ollama" (local, free)
LLM_PROVIDER=ollama
GEMINI_MODEL=gemini-2.0-flash

# Ollama Configuration (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
